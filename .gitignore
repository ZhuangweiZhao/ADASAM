# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Model weights (large binaries, fetched via tools/setup_mobilesam.py) ──
*.pt
*.pth
!thirdparty/**/*.pt
weights/*.pt
thirdparty/MobileSAM/weights/*.pt

# ── Datasets (external, not tracked) ──
data/
!tools/data/
!tools/data/*.py

# ── Experiment outputs ──
runs/
output/
/outputs/
*.jsonl
!tests/**/*.jsonl

# ── Docs & notes ──
docs/*
!docs/README.md
!docs/PROJECT_UPDATE_2026-08-10.md
!docs/research_log.md
!docs/TECHNICAL_DOCUMENTATION.md
!docs/SEMANTIC_BUDGET_PROTOCOL.md

# ── OS / editor ──
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

